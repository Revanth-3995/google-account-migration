# POC-1 Configuration (No Client Secret Required for Web Application Flow)
# Copy this file to .env and fill in your values from Google Cloud Console

PORT=3000

# Google OAuth 2.0 Web Client ID (from Google Cloud Console -> APIs & Services -> Credentials)
# Used by Google Identity Services (GIS) in the browser
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com

# Google API Key (from Google Cloud Console -> APIs & Services -> Credentials)
# Required by the Google Picker JavaScript SDK to render the file picker
GOOGLE_API_KEY=your_google_api_key_here

# Account B (Destination) Email Address
# Used to populate the sharing target in permissions.create
ACCOUNT_B_EMAIL=disposable_test_account_b@gmail.com
